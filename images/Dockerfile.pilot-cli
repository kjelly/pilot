# Control-node image for `pilot` — bundles the compiled `pilot` and
# `pilot-detection-engine` binaries together with ansible-core, the Galaxy
# collections the playbooks in this repo depend on, and the
# playbook/inventory/configuration templates themselves.
#
# Why this exists:
#   `pilot` is a thin Go wrapper: apply/verify ultimately shell out to
#   `ansible-playbook`/`ansible`/`ansible-inventory` (see
#   internal/ansible/runner.go), and the playbooks under playbooks/ use
#   ansible.posix / community.docker / community.postgresql modules.
#   Ansible-core does not run as a controller on native Windows, so a
#   plain cross-compiled `pilot.exe` still leaves the user to install
#   Python + ansible-core + collections by hand. This image collapses
#   all of that into one artifact that runs identically via
#   `docker run` on Windows (Docker Desktop) and Linux.
#
# What this image is FOR:
#   Running `pilot`/`ansible-playbook` against real hosts or an
#   already-provisioned target over SSH — i.e. playbooks/apply/*.yml,
#   playbooks/verify/*.yml, playbooks/site.yml.
#
# What this image is NOT for:
#   `pilot vm-target` (needs libvirt/KVM on the host) and
#   `pilot docker-target` (needs a Docker daemon) are disposable-VM/
#   -container test tooling for developing *this repo* — they are out
#   of scope here. Use pilot compiled natively for that, on a Linux dev
#   box. See images/Dockerfile.pilot-target-ubuntu for the *target*
#   side of that workflow.
#
# Build:
#   docker build -t pilot-cli:latest -f images/Dockerfile.pilot-cli .
#
# Use (mount your own inventory/vault/SSH key — none of that is baked
# into the image). No ENTRYPOINT is set, so the first argument after the
# image name is run directly — either `ansible-playbook`/`ansible-inventory`/
# `ansible-vault` (from ansible-core) or `pilot` itself:
#   docker run --rm -it \
#       -v "$HOME/.ssh:/root/.ssh:ro" \
#       -v "$(pwd)/inventory.yml:/pilot/inventory.yml:ro" \
#       -v "$HOME/.vault:/root/.vault:ro" \
#       pilot-cli:latest \
#       ansible-playbook -i inventory.yml playbooks/apply/<role>-apply.yml \
#           -e target_group=<group> -e @/root/.vault/<secrets>.yaml --check --diff
#
#   # or drive it through the pilot CLI itself:
#   docker run --rm -it -v "$HOME/.ssh:/root/.ssh:ro" pilot-cli:latest \
#       pilot spec docs/verification/<role>.md --lint

# ---------------------------------------------------------------------------
# Stage 1: build the pilot binary (static, no CGO, stripped).
# ---------------------------------------------------------------------------
FROM golang:1.26-bookworm AS builder

WORKDIR /src

ARG PILOT_GIT_SHA=unknown
ARG DETECTION_ENGINE_VERSION=0.0.0-dev

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY internal/ internal/
COPY images/ images/

RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/pilot ./cmd/pilot

# The control image is also the Ansible controller for the central Detection
# Engine. Build the target binary in the same immutable image so a deployment
# does not depend on a separately copied dist/ directory. Keep the checksum
# beside the binary: detection-engine-apply.yml verifies it before any target
# mutation and again after the copy.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath \
      -ldflags="-s -w -X main.version=${DETECTION_ENGINE_VERSION} -X main.commit=${PILOT_GIT_SHA}" \
      -o /out/pilot-detection-engine-linux-amd64 \
      ./cmd/pilot-detection-engine \
 && cd /out \
 && sha256sum pilot-detection-engine-linux-amd64 \
      > pilot-detection-engine-linux-amd64.sha256

# ---------------------------------------------------------------------------
# Stage 2: runtime — Python + ansible-core + the collections the playbooks
# in this repo use (ansible.posix, community.docker, community.postgresql),
# plus the pilot binary and the playbook/inventory templates.
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

# Keep uv out of the final base image's package manager and use it only as the
# fast, pip-compatible installer for the controller's system Python. Pin the
# release so an unrelated uv update cannot change this image's build behavior.
COPY --from=ghcr.io/astral-sh/uv:0.12.9 /uv /uvx /bin/

# Passed by `make pilot-cli-image`.  Keep this on the runtime stage so the
# resulting image can be traced with `docker image inspect` without adding git
# or the source worktree to the final image.
ARG PILOT_GIT_SHA=unknown
ARG PILOT_GIT_DIRTY=unknown
LABEL org.opencontainers.image.revision="${PILOT_GIT_SHA}" \
      io.pilot.git.dirty="${PILOT_GIT_DIRTY}"

# openssh-client / sshpass: reaching real hosts over SSH.
# git: ansible.builtin.git tasks (e.g. FreeIPA/Keycloak fetch steps).
# ca-certificates: HTTPS (get_url/uri tasks, uv, ansible-galaxy).
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-client \
        sshpass \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# docker: python SDK backing community.docker.*.
# psycopg2-binary: backing community.postgresql.*.
# community.general: backing community.general.nmcli (used by
#   playbooks/apply/freeipa-dns-client-apply.yml's EL/NetworkManager branch).
#   Added 2026-07-31: this was the first playbook in the repo to need
#   community.general, and its absence was only caught by actually running
#   the playbook through --sandbox against a real EL9 vm-target (AGENTS.md
#   §1.1 actual-run rule) — ansible failed with "couldn't resolve
#   module/action 'community.general.nmcli'" until this collection was added.
#

# Collections install to the system-wide path (-p), not the default
# ~/.ansible/collections: `pilot deploy`/`pilot reconcile` always set
# ANSIBLE_HOME to an isolated per-run directory (prepareDeployAnsibleRuntime
# in cmd/pilot/cmd/deploy.go), which redirects ansible-core's default
# collections search path away from $HOME. A collection installed only at
# the default path becomes invisible the moment ANSIBLE_HOME is overridden —
# confirmed live: `ansible-doc -l` under an overridden ANSIBLE_HOME showed
# zero community.docker/community.postgresql/ansible.posix modules, and the
# ansible.posix.json stdout callback (used by pilot's per-host verify step)
# failed to load with the same root cause. /usr/share/ansible/collections is
# ansible-core's other default search entry and does not depend on HOME/
# ANSIBLE_HOME, so it survives the redirection.
# Use the system interpreter because this is an isolated controller image and
# the installed Ansible entry points must remain directly available on PATH.
RUN uv pip install --system --no-cache \
        ansible-core \
        docker \
        psycopg2-binary \
    && ansible-galaxy collection install -p /usr/share/ansible/collections \
        ansible.posix \
        community.docker \
        community.postgresql \
        community.general

COPY --from=builder /out/pilot /usr/local/bin/pilot
COPY --from=builder /out/pilot-detection-engine-linux-amd64 /pilot/dist/pilot-detection-engine-linux-amd64
COPY --from=builder /out/pilot-detection-engine-linux-amd64.sha256 /pilot/dist/pilot-detection-engine-linux-amd64.sha256

WORKDIR /pilot
COPY playbooks/ playbooks/
COPY group_vars/ group_vars/
COPY contracts/ contracts/
COPY docs/verification/ docs/verification/
COPY monitoring/ monitoring/
COPY ansible.cfg ansible.cfg
COPY inventory.example.yml inventory.example.yml
COPY hosts.example.yml hosts.example.yml

# No ENTRYPOINT: this image bundles two toolchains callers need to invoke
# directly — `pilot ...` (Go binary) and `ansible-playbook`/`ansible-inventory`/
# `ansible-vault` (from ansible-core, on PATH). An `ENTRYPOINT ["pilot"]` would
# swallow the first argument of any `docker run <image> ansible-playbook ...`
# invocation and turn it into `pilot ansible-playbook ...`, which pilot doesn't
# recognize. Leaving ENTRYPOINT unset lets `docker run <image> <anything on
# PATH> [args...]` work as-is; CMD only supplies a default when no command is
# given.
CMD ["pilot", "--help"]
